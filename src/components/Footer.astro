---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";
import { useTranslations } from "@/i18n";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const currentYear = new Date().getFullYear();
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class="flex flex-col gap-7">
    <div class="grid gap-6 sm:grid-cols-[1.3fr_1fr] sm:items-start">
      <div class="max-w-md">
        <a href="/" class="inline-block text-xl font-extrabold tracking-tight text-white">
          WAVES<span class="text-sky-300">FOREX</span>
        </a>
        <p class="mt-3 text-sm leading-7 text-slate-300">
          Independent financial education and market insights. Learn about
          Forex, currencies, gold and the global economy with clear,
          accessible resources.
        </p>
      </div>
      <div>
        <p class="mb-3 text-xs font-bold tracking-[.14em] text-sky-300 uppercase">
          Explore WavesForex
        </p>
        <nav
          aria-label="Footer navigation"
          class="flex flex-wrap gap-x-5 gap-y-3 text-sm"
        >
          <a href="/posts/">Articles</a>
          <a href="/about/">About</a>
          <a href="/privacy-policy/">Privacy Policy</a>
          <a href="/disclaimer/">Disclaimer</a>
          <a href="/contact/">Contact</a>
        </nav>
      </div>
    </div>
    <div class="flex flex-col gap-4 border-t border-slate-600/60 pt-5 sm:flex-row sm:items-center sm:justify-between">
      <div class="text-xs text-slate-300">
        <span>{t.footer.copyright} &#169; {currentYear}</span>
        <span class="mx-2">·</span>
        <span>{t.footer.allRightsReserved}</span>
      </div>
      <Socials />
    </div>
  </div>
</footer>
