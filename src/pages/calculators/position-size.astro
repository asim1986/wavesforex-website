---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

const title = "Forex Position Size Calculator | WavesForex";
const description = "Calculate an illustrative forex position size using account balance, risk percentage, entry price, stop-loss price and pip value.";
---

<Layout title={title} description={description}>
  <Header />
  <main id="main-content" class="app-layout calculator-page">
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-muted-foreground">
      <a href="/" class="hover:text-accent">Home</a>
      <span aria-hidden="true"> / </span>
      <a href="/calculators/" class="hover:text-accent">Calculators</a>
      <span aria-hidden="true"> / Position Size</span>
    </nav>

    <section class="calculator-intro">
      <p class="eyebrow">WavesForex trading tools</p>
      <h1>Forex Position Size Calculator</h1>
      <p>Understand how much currency exposure corresponds to a chosen account risk and stop-loss distance. Set your inputs below to calculate an illustrative position size.</p>
    </section>

    <section class="calculator-shell" aria-labelledby="calculator-heading">
      <div class="calculator-form">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Your trade details</p>
            <h2 id="calculator-heading">Enter your values</h2>
          </div>
          <span class="tool-label">Forex</span>
        </div>

        <form id="position-form">
          <div class="field-grid">
            <label class="field">
              <span>Account balance (USD)</span>
              <input id="balance" type="number" min="0.01" step="any" value="10000" required />
            </label>
            <label class="field">
              <span>Risk per trade (%)</span>
              <input id="risk" type="number" min="0.01" max="100" step="any" value="1" required />
            </label>
            <label class="field">
              <span>Entry price</span>
              <input id="entry" type="number" min="0.00000001" step="any" value="1.08500" required />
            </label>
            <label class="field">
              <span>Stop-loss price</span>
              <input id="stop" type="number" min="0.00000001" step="any" value="1.08200" required />
            </label>
            <label class="field">
              <span>Pip size</span>
              <select id="pip-size">
                <option value="0.0001" selected>0.0001 — most major pairs</option>
                <option value="0.01">0.01 — JPY pairs</option>
                <option value="0.1">0.1 — custom instrument</option>
                <option value="1">1.0 — custom instrument</option>
              </select>
            </label>
            <label class="field">
              <span>Pip value per standard lot (USD)</span>
              <input id="pip-value" type="number" min="0.000001" step="any" value="10" required />
              <small>Enter the pip value for one standard lot in your account currency.</small>
            </label>
          </div>
          <button class="calculate-button" type="submit">Calculate position size <span aria-hidden="true">→</span></button>
          <p id="form-error" class="form-error" role="alert" aria-live="polite"></p>
        </form>
      </div>

      <aside class="results-panel" aria-live="polite" aria-label="Calculation results">
        <p class="eyebrow">Your calculation</p>
        <h2>Estimated position size</h2>
        <p class="result-caption">Based on the values entered</p>
        <div class="main-result">
          <span id="lots-result">0.33</span>
          <span>lots</span>
        </div>
        <div class="result-list">
          <div><span>Cash risk</span><strong id="cash-risk">$100.00</strong></div>
          <div><span>Stop distance</span><strong id="stop-pips">30.0 pips</strong></div>
          <div><span>Position units</span><strong id="units-result">33,333</strong></div>
        </div>
        <p class="result-note">This is an estimate, not an order instruction. Actual exposure can differ because of spreads, commissions, slippage, contract specifications and currency conversion.</p>
      </aside>
    </section>

    <section class="explainer-grid">
      <article class="info-card">
        <p class="eyebrow">The calculation</p>
        <h2>How position size is estimated</h2>
        <p>The calculator first estimates the cash amount represented by your selected risk percentage. It then compares that amount with the potential loss per standard lot at the stop distance.</p>
        <div class="formula">
          <strong>Position size (lots)</strong>
          <span>Cash risk ÷ (Stop distance in pips × Pip value per lot)</span>
        </div>
        <p>For example, a $10,000 balance at 1% risk represents $100 of planned risk. With a 30-pip stop and a $10 pip value per standard lot, the illustrative size is 0.33 lots.</p>
      </article>
      <article class="info-card">
        <p class="eyebrow">Important to understand</p>
        <h2>Pip value is not universal</h2>
        <p>Pip value depends on the currency pair, position size and account currency. The default $10 value is a common approximation for one standard lot of many USD-quoted major pairs, not a universal value.</p>
        <p>For JPY pairs, cross-currency pairs, metals, indices and other CFDs, check your broker's contract specifications or a suitable pip-value calculator and enter the correct value.</p>
      </article>
    </section>

    <section class="related-reading">
      <h2>Learn more about trading risk</h2>
      <p>Position sizing is one part of a broader risk-management process. Understand drawdowns, leverage, execution and the limits of stop-loss orders before making decisions.</p>
      <a href="/posts/risk-management-in-trading/">Read our risk management guide <span aria-hidden="true">→</span></a>
    </section>

    <p class="disclaimer">Educational use only. This calculator provides an estimate and does not constitute financial or investment advice. It does not guarantee the maximum loss will be limited to the calculated amount. Market gaps, slippage, spreads, commissions and contract rules can change the actual result.</p>
  </main>
  <Footer />
</Layout>

<style>
  .calculator-page { padding-top: 2rem; padding-bottom: 4rem; }
  .calculator-intro { max-width: 760px; margin: 0 auto 2rem; text-align: center; }
  .eyebrow { color: var(--accent); font-size: .72rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  .calculator-intro h1 { margin: .55rem 0 .8rem; font-size: clamp(2rem, 5vw, 3.3rem); line-height: 1.1; font-weight: 800; letter-spacing: -.045em; }
  .calculator-intro > p:last-child { color: var(--foreground-soft); font-size: 1.05rem; line-height: 1.75; }
  .calculator-shell { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(280px, .8fr); overflow: hidden; border: 1px solid var(--border); border-radius: 20px; background: var(--surface); box-shadow: var(--shadow-soft); }
  .calculator-form { padding: clamp(1.2rem, 3vw, 2rem); }
  .section-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; }
  .section-heading h2, .results-panel h2, .info-card h2, .related-reading h2 { margin-top: .25rem; font-size: 1.35rem; font-weight: 750; letter-spacing: -.025em; }
  .tool-label { border: 1px solid var(--border); border-radius: 99px; padding: .35rem .7rem; color: var(--muted-foreground); font-size: .75rem; font-weight: 700; }
  .field-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.1rem; }
  .field { display: flex; flex-direction: column; gap: .45rem; color: var(--foreground); font-size: .88rem; font-weight: 650; }
  .field input, .field select { width: 100%; min-height: 46px; border: 1px solid var(--border); border-radius: 9px; background: var(--background); color: var(--foreground); padding: .65rem .75rem; font: inherit; font-weight: 450; }
  .field input:focus, .field select:focus { outline: 2px solid var(--accent); outline-offset: 2px; }
  .field small { color: var(--muted-foreground); font-size: .73rem; font-weight: 400; line-height: 1.45; }
  .calculate-button { display: flex; width: 100%; justify-content: center; gap: .6rem; margin-top: 1.5rem; border: 0; border-radius: 10px; background: var(--accent); color: white; padding: .9rem 1rem; font: inherit; font-weight: 750; }
  .calculate-button:hover { filter: brightness(1.08); }
  .form-error { min-height: 1.3rem; margin-top: .6rem; color: #dc4545; font-size: .83rem; }
  .results-panel { display: flex; flex-direction: column; justify-content: center; padding: clamp(1.4rem, 3vw, 2rem); background: var(--surface-soft); border-inline-start: 1px solid var(--border); }
  .results-panel h2 { font-size: 1.5rem; }
  .result-caption { color: var(--muted-foreground); font-size: .82rem; }
  .main-result { display: flex; align-items: baseline; gap: .5rem; margin: 1.1rem 0 1.4rem; color: var(--accent); }
  .main-result span:first-child { font-size: clamp(2.8rem, 5vw, 4rem); line-height: 1; font-weight: 850; letter-spacing: -.06em; font-variant-numeric: tabular-nums; }
  .main-result span:last-child { color: var(--foreground-soft); font-weight: 650; }
  .result-list { border-top: 1px solid var(--border); }
  .result-list div { display: flex; justify-content: space-between; gap: 1rem; padding: .8rem 0; border-bottom: 1px solid var(--border); font-size: .86rem; }
  .result-list div span { color: var(--muted-foreground); }
  .result-list strong { font-variant-numeric: tabular-nums; text-align: right; }
  .result-note { margin-top: 1rem; color: var(--muted-foreground); font-size: .75rem; line-height: 1.6; }
  .explainer-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 1.5rem; }
  .info-card, .related-reading { padding: 1.4rem; border: 1px solid var(--border); border-radius: 16px; background: var(--surface); }
  .info-card p:not(.eyebrow), .related-reading p { margin-top: .8rem; color: var(--foreground-soft); font-size: .9rem; line-height: 1.75; }
  .formula { display: flex; flex-direction: column; gap: .45rem; margin-top: 1rem; border-inline-start: 3px solid var(--accent); border-radius: 0 8px 8px 0; background: var(--surface-soft); padding: .9rem 1rem; font-size: .85rem; }
  .formula span { color: var(--foreground-soft); }
  .related-reading { margin-top: 1rem; }
  .related-reading a { display: inline-block; margin-top: .9rem; color: var(--accent); font-size: .9rem; font-weight: 750; }
  .disclaimer { margin-top: 1.5rem; color: var(--muted-foreground); font-size: .76rem; line-height: 1.65; }
  @media (max-width: 760px) { .calculator-shell { grid-template-columns: 1fr; } .results-panel { border-inline-start: 0; border-top: 1px solid var(--border); } }
  @media (max-width: 520px) { .field-grid, .explainer-grid { grid-template-columns: 1fr; } }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>("#position-form");
  const error = document.querySelector<HTMLElement>("#form-error");

  const readNumber = (id: string) => Number((document.getElementById(id) as HTMLInputElement).value);
  const money = (value: number) => new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 2 }).format(value);
  const number = (value: number, digits = 2) => new Intl.NumberFormat("en-US", { maximumFractionDigits: digits }).format(value);

  form?.addEventListener("submit", event => {
    event.preventDefault();
    if (error) error.textContent = "";

    const balance = readNumber("balance");
    const riskPercent = readNumber("risk");
    const entry = readNumber("entry");
    const stop = readNumber("stop");
    const pipSize = readNumber("pip-size");
    const pipValue = readNumber("pip-value");

    if ([balance, riskPercent, entry, stop, pipSize, pipValue].some(value => !Number.isFinite(value) || value <= 0)) {
      if (error) error.textContent = "Please enter valid numbers greater than zero in every field.";
      return;
    }
    if (riskPercent > 100) {
      if (error) error.textContent = "Risk percentage cannot be greater than 100%.";
      return;
    }
    if (entry === stop) {
      if (error) error.textContent = "Entry and stop-loss prices must be different.";
      return;
    }

    const stopPips = Math.abs(entry - stop) / pipSize;
    const cashRisk = balance * riskPercent / 100;
    const lots = cashRisk / (stopPips * pipValue);
    const units = lots * 100000;

    (document.getElementById("lots-result") as HTMLElement).textContent = number(lots, 4);
    (document.getElementById("cash-risk") as HTMLElement).textContent = money(cashRisk);
    (document.getElementById("stop-pips") as HTMLElement).textContent = number(stopPips, 1) + " pips";
    (document.getElementById("units-result") as HTMLElement).textContent = number(units, 0);
  });
</script>
