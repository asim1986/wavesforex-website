---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
---

<Layout
  title="Forex Calculators | WavesForex"
  description="Practical forex calculators to help understand position size, pip value, risk and trading exposure."
>
  <Header />
  <main id="main-content" class="app-layout calculators-index">
    <p class="eyebrow">WavesForex trading tools</p>
    <h1>Forex Calculators</h1>
    <p class="intro">Practical tools to help you understand trading calculations, financial exposure and market risk.</p>

    <section class="tool-card">
      <div class="tool-icon" aria-hidden="true">01</div>
      <div class="tool-copy">
        <p class="eyebrow">Risk management</p>
        <h2>Forex Position Size Calculator</h2>
        <p>Estimate position size using your account balance, risk percentage, entry price, stop-loss distance and pip value.</p>
        <a href="/calculators/position-size/">Open calculator <span aria-hidden="true">→</span></a>
      </div>
      <span class="available">Available</span>
    </section>

    <p class="coming-soon">More calculators will be added in stages, with each tool checked for calculation accuracy and clear explanations.</p>
  </main>
  <Footer />
</Layout>

<style>
  .calculators-index { padding-top: 3rem; padding-bottom: 5rem; }
  .eyebrow { color: var(--accent); font-size: .72rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  h1 { margin: .55rem 0 .8rem; font-size: clamp(2.2rem, 5vw, 3.5rem); font-weight: 800; letter-spacing: -.045em; }
  .intro { max-width: 680px; color: var(--foreground-soft); font-size: 1.05rem; line-height: 1.75; }
  .tool-card { display: flex; align-items: center; gap: 1.3rem; margin-top: 2.5rem; padding: clamp(1.2rem, 3vw, 2rem); border: 1px solid var(--border); border-radius: 18px; background: var(--surface); box-shadow: var(--shadow-soft); }
  .tool-icon { display: grid; flex: 0 0 58px; width: 58px; height: 58px; place-items: center; border-radius: 14px; background: var(--surface-soft); color: var(--accent); font-size: 1.1rem; font-weight: 850; }
  .tool-copy { flex: 1; }
  .tool-copy h2 { margin-top: .3rem; font-size: 1.35rem; font-weight: 750; }
  .tool-copy p:not(.eyebrow) { margin-top: .45rem; color: var(--foreground-soft); font-size: .9rem; line-height: 1.65; }
  .tool-copy a { display: inline-block; margin-top: .9rem; color: var(--accent); font-size: .9rem; font-weight: 750; }
  .available { flex: 0 0 auto; border-radius: 99px; background: var(--surface-soft); padding: .35rem .7rem; color: var(--accent); font-size: .75rem; font-weight: 750; }
  .coming-soon { margin-top: 1.5rem; color: var(--muted-foreground); font-size: .85rem; line-height: 1.65; }
  @media (max-width: 600px) { .tool-card { align-items: flex-start; flex-wrap: wrap; } .available { margin-inline-start: 4.8rem; } }
</style>
