---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
---

<Layout title="Forex Calculators | Waves Forex" description="Free educational forex calculators for position sizing, pip value, margin, leverage, risk and reward, stop-loss, take-profit and profit or loss.">
  <Header />
  <main id="main-content" class="app-layout my-8">
    <section class="mb-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-accent">Waves Forex tools</p>
      <h1 class="mb-4 text-3xl font-bold tracking-tight sm:text-4xl">Forex calculators</h1>
      <p class="max-w-2xl text-lg opacity-80">Understand the numbers behind a forex trade with simple, transparent calculators. Enter your own assumptions and review the formulas before using any result.</p>
    </section>

    <section class="mb-10 rounded-2xl border border-border bg-background p-5 shadow-sm sm:p-7">
      <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 class="text-xl font-semibold">Calculator workspace</h2>
          <p class="mt-1 text-sm opacity-70">Choose a tool and enter the required values.</p>
        </div>
        <span class="rounded-full border border-border px-3 py-1 text-xs font-medium">Educational tools</span>
      </div>
      <label for="calculator-type" class="mb-2 block text-sm font-medium">Choose calculator</label>
      <select id="calculator-type" class="mb-6 w-full rounded-lg border border-border bg-background px-3 py-3 sm:max-w-md">
        <option value="position">Position size</option>
        <option value="pip">Pip value</option>
        <option value="lots">Lot size converter</option>
        <option value="margin">Forex margin</option>
        <option value="leverage">Effective leverage</option>
        <option value="rr">Risk/reward ratio</option>
        <option value="risk">Risk percentage</option>
        <option value="stop">Stop-loss distance</option>
        <option value="target">Take-profit price</option>
        <option value="pnl">Forex profit/loss</option>
      </select>

      <form id="calculator-form" class="grid gap-4 sm:grid-cols-2" novalidate>
        <div id="calculator-fields" class="contents"></div>
        <div class="sm:col-span-2">
          <button type="submit" class="rounded-lg bg-accent px-5 py-3 font-semibold text-white transition hover:opacity-90">Calculate</button>
          <button type="reset" id="reset-calculator" class="ml-2 rounded-lg border border-border px-5 py-3 font-medium transition hover:bg-muted">Reset</button>
        </div>
      </form>
      <div id="calculator-result" class="mt-6 hidden rounded-xl border border-border bg-muted/40 p-5" aria-live="polite">
        <p class="text-sm font-medium opacity-70">Estimated result</p>
        <p id="result-value" class="mt-1 text-3xl font-bold tracking-tight"></p>
        <p id="result-note" class="mt-2 text-sm opacity-75"></p>
      </div>
      <p id="calculator-error" class="mt-4 hidden text-sm font-medium text-red-600" role="alert"></p>
    </section>

    <section class="mb-12">
      <h2 class="mb-5 text-2xl font-semibold">All 10 calculators</h2>
      <div class="grid gap-3 sm:grid-cols-2">
        {[
          ["01", "Position size", "Estimate position units from a risk budget and stop distance.", "position"],
          ["02", "Pip value", "Estimate pip value using units, pip size and a conversion rate.", "pip"],
          ["03", "Lot size", "Convert currency units into standard-lot equivalents.", "lots"],
          ["04", "Forex margin", "Estimate margin from notional value and leverage.", "margin"],
          ["05", "Effective leverage", "Compare notional exposure with account equity.", "leverage"],
          ["06", "Risk/reward ratio", "Compare a potential reward distance with risk distance.", "rr"],
          ["07", "Risk percentage", "Express a potential loss as a percentage of balance.", "risk"],
          ["08", "Stop-loss distance", "Convert entry-to-stop price distance into pips.", "stop"],
          ["09", "Take-profit price", "Calculate a theoretical target from entry, stop and reward/risk.", "target"],
          ["10", "Forex profit/loss", "Estimate gross P/L from units, entry, exit and direction.", "pnl"],
        ].map(([number, name, description, key]) => (
          <button type="button" data-calculator={key} class="calculator-card rounded-xl border border-border p-4 text-left transition hover:border-accent hover:bg-muted/30">
            <span class="text-xs font-semibold tracking-widest text-accent">{number} / TOOL</span>
            <span class="mt-2 block font-semibold">{name}</span>
            <span class="mt-1 block text-sm opacity-70">{description}</span>
          </button>
        ))}
      </div>
    </section>

    <section class="mb-10 rounded-xl border border-border p-5">
      <h2 class="mb-2 text-lg font-semibold">Important assumptions</h2>
      <p class="text-sm leading-6 opacity-80">These tools are for general education only. Results depend on the inputs and assumptions you provide. Currency conversion rates, contract sizes, pip conventions, spreads, commissions, swaps, broker margin rules and rounding can differ. Position size and margin estimates are not guarantees of the amount a broker will accept or the loss a trade will incur. Check your broker's specifications and consider all costs independently.</p>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  import {
    convertQuoteToAccountCurrency,
    effectiveLeverage,
    grossProfitLossInQuoteCurrency,
    lotsToUnits,
    netProfitLoss,
    pipValueInQuoteCurrency,
    positionUnitsFromRisk,
    priceDistanceToPips,
    requiredMargin,
    riskAmount,
    riskPercentage,
    rewardToRiskRatio,
    unitsToLots,
  } from "@/lib/forex-calculators";

  type Field = { name: string; label: string; value: string; step?: string; hint?: string };
  const definitions: Record<string, { title: string; fields: Field[] }> = {
    position: { title: "Position size", fields: [
      { name: "balance", label: "Account balance", value: "1000" },
      { name: "riskPercent", label: "Risk percentage (%)", value: "1", step: "0.01" },
      { name: "stopPips", label: "Stop distance (pips)", value: "20", step: "0.1" },
      { name: "pipUnitValue", label: "Pip value per unit in account currency", value: "0.0001", step: "0.000001", hint: "Supply the converted pip value for one unit." },
    ]},
    pip: { title: "Pip value", fields: [
      { name: "units", label: "Currency units", value: "10000" },
      { name: "pipSize", label: "Pip size", value: "0.0001", step: "0.000001" },
      { name: "conversion", label: "Quote-to-account conversion rate", value: "1", step: "0.0001", hint: "Use 1 when quote and account currencies are the same." },
    ]},
    lots: { title: "Lot size converter", fields: [
      { name: "units", label: "Currency units", value: "10000" },
      { name: "unitsPerLot", label: "Units per standard lot", value: "100000" },
    ]},
    margin: { title: "Forex margin", fields: [
      { name: "notional", label: "Notional value in account currency", value: "10000" },
      { name: "leverage", label: "Leverage (e.g. 30 for 1:30)", value: "30" },
    ]},
    leverage: { title: "Effective leverage", fields: [
      { name: "notional", label: "Notional exposure in account currency", value: "10000" },
      { name: "equity", label: "Account equity", value: "1000" },
    ]},
    rr: { title: "Risk/reward ratio", fields: [
      { name: "riskDistance", label: "Risk distance", value: "20", step: "0.1" },
      { name: "rewardDistance", label: "Reward distance", value: "30", step: "0.1" },
    ]},
    risk: { title: "Risk percentage", fields: [
      { name: "loss", label: "Potential loss in account currency", value: "20" },
      { name: "balance", label: "Account balance", value: "1000" },
    ]},
    stop: { title: "Stop-loss distance", fields: [
      { name: "entry", label: "Entry price", value: "1.0850", step: "0.00001" },
      { name: "stop", label: "Stop-loss price", value: "1.0820", step: "0.00001" },
      { name: "pipSize", label: "Pip size", value: "0.0001", step: "0.000001" },
    ]},
    target: { title: "Take-profit price", fields: [
      { name: "entry", label: "Entry price", value: "1.0850", step: "0.00001" },
      { name: "stop", label: "Stop-loss price", value: "1.0820", step: "0.00001" },
      { name: "rr", label: "Reward/risk multiple", value: "1.5", step: "0.1" },
      { name: "direction", label: "Position direction (1 = long, -1 = short)", value: "1", step: "1" },
    ]},
    pnl: { title: "Forex profit/loss", fields: [
      { name: "units", label: "Currency units", value: "10000" },
      { name: "entry", label: "Entry price", value: "1.0850", step: "0.00001" },
      { name: "exit", label: "Exit price", value: "1.0900", step: "0.00001" },
      { name: "direction", label: "Position direction (1 = long, -1 = short)", value: "1", step: "1" },
      { name: "conversion", label: "Quote-to-account conversion rate", value: "1", step: "0.0001" },
      { name: "costs", label: "Estimated total costs in account currency", value: "0", step: "0.01" },
    ]},
  };

  const selector = document.querySelector<HTMLSelectElement>("#calculator-type")!;
  const form = document.querySelector<HTMLFormElement>("#calculator-form")!;
  const fieldsContainer = document.querySelector<HTMLDivElement>("#calculator-fields")!;
  const resultPanel = document.querySelector<HTMLDivElement>("#calculator-result")!;
  const resultValue = document.querySelector<HTMLParagraphElement>("#result-value")!;
  const resultNote = document.querySelector<HTMLParagraphElement>("#result-note")!;
  const errorPanel = document.querySelector<HTMLParagraphElement>("#calculator-error")!;

  function renderFields() {
    const definition = definitions[selector.value];
    fieldsContainer.innerHTML = definition.fields.map(field => `
      <label class="block text-sm font-medium">
        ${field.label}
        <input name="${field.name}" type="number" inputmode="decimal" step="${field.step ?? "any"}" value="${field.value}" required class="mt-2 w-full rounded-lg border border-border bg-background px-3 py-3 font-normal" />
        ${field.hint ? `<span class="mt-1 block text-xs font-normal opacity-65">${field.hint}</span>` : ""}
      </label>
    `).join("");
    resultPanel.classList.add("hidden");
    errorPanel.classList.add("hidden");
  }

  function values(): Record<string, number> {
    const data = new FormData(form);
    return Object.fromEntries([...data.entries()].map(([key, value]) => [key, Number(value)]));
  }
  function showResult(value: number, note: string, suffix = "") {
    if (!Number.isFinite(value)) throw new RangeError("The inputs do not produce a finite result.");
    resultValue.textContent = new Intl.NumberFormat(undefined, { maximumFractionDigits: 6 }).format(value) + suffix;
    resultNote.textContent = note;
    resultPanel.classList.remove("hidden");
    errorPanel.classList.add("hidden");
  }
  function calculate(v: Record<string, number>) {
    switch (selector.value) {
      case "position": {
        const budget = riskAmount(v.balance, v.riskPercent);
        const units = positionUnitsFromRisk(budget, v.stopPips, v.pipUnitValue);
        showResult(units, `Risk budget: ${budget.toFixed(2)} account-currency units. Position size is shown in currency units; convert to lots using your contract specification.`, " units"); break;
      }
      case "pip": {
        const quoteValue = pipValueInQuoteCurrency(v.units, v.pipSize);
        showResult(convertQuoteToAccountCurrency(quoteValue, v.conversion), "Estimated value of one pip in your account currency."); break;
      }
      case "lots": showResult(unitsToLots(v.units, v.unitsPerLot), "Lot equivalent. Contract size varies by instrument and broker.", " lots"); break;
      case "margin": showResult(requiredMargin(v.notional, v.leverage), "Estimated required margin in account currency. Actual broker requirements may differ."); break;
      case "leverage": showResult(effectiveLeverage(v.notional, v.equity), "Exposure divided by account equity.", "x"); break;
      case "rr": showResult(rewardToRiskRatio(v.rewardDistance, v.riskDistance), "Potential reward distance divided by risk distance; expressed as a reward-to-risk multiple.", "x"); break;
      case "risk": showResult(riskPercentage(v.loss, v.balance), "Potential loss as a percentage of the entered balance.", "%"); break;
      case "stop": showResult(priceDistanceToPips(Math.abs(v.entry - v.stop), v.pipSize), "Absolute entry-to-stop distance, expressed in pips.", " pips"); break;
      case "target": {
        const direction = v.direction === 1 ? 1 : v.direction === -1 ? -1 : 0;
        if (!direction) throw new RangeError("Direction must be 1 for long or -1 for short.");
        const risk = Math.abs(v.entry - v.stop);
        if (risk <= 0) throw new RangeError("Entry and stop prices must be different.");
        showResult(v.entry + direction * risk * v.rr, "Theoretical target price based on the entered reward/risk multiple."); break;
      }
      case "pnl": {
        const direction = v.direction === 1 ? "long" : v.direction === -1 ? "short" : null;
        if (!direction) throw new RangeError("Direction must be 1 for long or -1 for short.");
        const grossQuote = grossProfitLossInQuoteCurrency(v.units, v.entry, v.exit, direction);
        const grossAccount = convertQuoteToAccountCurrency(Math.abs(grossQuote), v.conversion) * Math.sign(grossQuote);
        const net = netProfitLoss(grossAccount, v.costs, 0, 0);
        showResult(net, "Estimated net P/L in account currency after the entered total costs; financing and execution differences may not be included."); break;
      }
    }
  }

  selector.addEventListener("change", renderFields);
  form.addEventListener("submit", event => {
    event.preventDefault();
    try { calculate(values()); }
    catch (error) {
      errorPanel.textContent = error instanceof Error ? error.message : "Please check your inputs.";
      errorPanel.classList.remove("hidden");
      resultPanel.classList.add("hidden");
    }
  });
  form.addEventListener("reset", () => {
    window.setTimeout(() => { renderFields(); }, 0);
  });
  document.querySelectorAll<HTMLButtonElement>("[data-calculator]").forEach(button => {
    button.addEventListener("click", () => {
      selector.value = button.dataset.calculator ?? "position";
      renderFields();
      document.querySelector("#calculator-form")?.scrollIntoView({ behavior: "smooth", block: "center" });
    });
  });
  renderFields();
</script>
