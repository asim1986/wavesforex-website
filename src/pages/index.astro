---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
const postsPath = getRelativeLocaleUrl(locale, "posts");
const aboutPath = getRelativeLocaleUrl(locale, "about");
---

<Layout
  title="WavesForex | Forex Education, Market Insights & Trading Tools"
  description="Independent Forex education, financial market insights, gold and currency guides, and practical trading resources."
>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" aria-labelledby="hero-title">
      <p class="hero-eyebrow">Financial markets & education</p>
      <h1 id="hero-title">Understand the markets. Trade with knowledge.</h1>
      <p>
        Clear Forex education, currency and gold market insights, and practical
        resources to help you understand how financial markets work.
      </p>
      <div class="hero-actions">
        <a class="hero-primary" href={postsPath}>
          Explore articles <IconArrowRight class="ms-2 inline-block" />
        </a>
        <a class="hero-secondary" href={aboutPath}>About WavesForex</a>
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          aria-labelledby="featured-title"
          class:list={[
            "pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
            <div>
              <p class="mb-1 text-xs font-bold tracking-[.15em] text-accent uppercase">
                Editor's selection
              </p>
              <h2 id="featured-title">{t.home.featured}</h2>
            </div>
          </div>
          <ul>
            {featuredPosts.map(data => <Card variant="h3" {...data} />)}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pb-6" aria-labelledby="recent-title">
          <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
            <div>
              <p class="mb-1 text-xs font-bold tracking-[.15em] text-accent uppercase">
                From the newsroom
              </p>
              <h2 id="recent-title">{t.home.recentPosts}</h2>
            </div>
            <a
              href={postsPath}
              class="text-sm font-semibold text-accent hover:underline"
            >
              View all articles <IconArrowRight class="ms-1 inline-block" />
            </a>
          </div>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <section
      class="mt-8 rounded-2xl border border-border bg-surface p-6 shadow-sm sm:p-8"
      aria-labelledby="topics-title"
    >
      <p class="mb-1 text-xs font-bold tracking-[.15em] text-accent uppercase">
        Learn at your pace
      </p>
      <h2 id="topics-title" class="mb-3 text-2xl font-bold tracking-tight">
        Explore financial markets
      </h2>
      <p class="max-w-3xl text-sm leading-7 text-muted-foreground">
        Build your understanding of currency markets, trading fundamentals,
        gold and commodities, and the economic events that influence prices.
      </p>
      <div class="mt-5 flex flex-wrap gap-2">
        {["Forex fundamentals", "Trading education", "Gold & commodities", "Macroeconomics"].map(topic => (
          <span class="rounded-full border border-border bg-background px-3 py-2 text-sm font-medium text-foreground">
            {topic}
          </span>
        ))}
      </div>
    </section>

    <div class="my-10 text-center">
      <LinkButton href={postsPath}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
